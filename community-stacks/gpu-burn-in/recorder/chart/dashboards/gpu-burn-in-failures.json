{
  "uid": "gpu-burn-in-failures",
  "title": "GPU Burn-In: Failures",
  "description": "Every server whose latest qualification did not pass: why, where, and for how long.",
  "tags": [
    "vcluster",
    "fleet-observability",
    "gpu",
    "qualification",
    "burn-in",
    "failures"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "links": [
    {
      "title": "GPU Burn-In",
      "url": "/d/gpu-burn-in",
      "type": "link",
      "tags": [],
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "GPU Burn-In: Server",
      "url": "/d/gpu-burn-in-server",
      "type": "link",
      "tags": [],
      "keepTime": true,
      "includeVars": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(gpu_qualification_passed{}, provider)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(gpu_qualification_passed{}, provider)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "profile",
        "label": "Profile",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(gpu_qualification_passed{provider=~\"$provider\"}, profile)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(gpu_qualification_passed{provider=~\"$provider\"}, profile)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "gpu_model",
        "label": "GPU model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(gpu_qualification_passed{provider=~\"$provider\",profile=~\"$profile\"}, gpu_model)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(gpu_qualification_passed{provider=~\"$provider\",profile=~\"$profile\"}, gpu_model)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(gpu_qualification_passed{provider=~\"$provider\"}, site)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(gpu_qualification_passed{provider=~\"$provider\"}, site)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "rack",
        "label": "Rack",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(gpu_qualification_passed{provider=~\"$provider\",site=~\"$site\"}, rack)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(gpu_qualification_passed{provider=~\"$provider\",site=~\"$site\"}, rack)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Summary",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Not qualified",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(gpu_qualification_failure_info{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Failing repeatedly",
      "description": "Servers whose two or more newest reports did not pass: likely hardware, not a one-off.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(gpu_qualification_consecutive_failures{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\"} >= 2) or vector(0)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Racks affected",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(count by (site, rack) (gpu_qualification_failure_info{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\"})) or vector(0)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Oldest open failure",
      "description": "When the longest-failing server's latest qualification finished.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min(gpu_qualification_finished_timestamp_seconds{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\"} and on (machine) (gpu_qualification_passed{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\"} == 0)) * 1000",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Not-qualified servers",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Not-qualified servers",
      "description": "One row per server whose latest qualification failed or errored, newest first. Click a machine for its history.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gpu_qualification_failure_info{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\"}",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (machine) (gpu_qualification_finished_timestamp_seconds{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\"}) * 1000",
          "refId": "B",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (machine) (gpu_qualification_consecutive_failures{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\"})",
          "refId": "C",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (machine) (gpu_qualification_gpus{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\",kind=\"found\"})",
          "refId": "D",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (machine) (gpu_qualification_gpus{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\",kind=\"expected\"})",
          "refId": "E",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (machine) (gpu_qualification_test_metric{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\",test=\"inventory\",metric=\"uncorrected_ecc_errors\"})",
          "refId": "F",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (machine) (gpu_qualification_test_metric{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\",test=\"soak\",metric=\"peak_temp_c\"})",
          "refId": "G",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (machine) (gpu_qualification_test_metric{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\",test=\"soak\",metric=\"gpus_with_xid\"})",
          "refId": "H",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (machine) (gpu_qualification_test_metric{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\",test=\"inventory\",metric=\"inactive_nvlinks\"})",
          "refId": "I",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (machine) (gpu_qualification_test_metric{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\",test=\"inventory\",metric=\"fabric_unhealthy_gpus\"})",
          "refId": "J",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (machine) (gpu_qualification_test_metric{provider=~\"$provider\",profile=~\"$profile\",gpu_model=~\"$gpu_model\",site=~\"$site\",rack=~\"$rack\",test=\"soak\",metric=\"gpus_with_nvlink_errors\"})",
          "refId": "K",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "machine",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "machine",
                "site",
                "rack",
                "gpu_model",
                "result",
                "failed_tests",
                "summary",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E",
                "Value #F",
                "Value #G",
                "Value #H",
                "Value #I",
                "Value #J",
                "Value #K",
                "inventory_url",
                "report"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "machine": true,
              "site": true,
              "rack": true,
              "gpu_model": true,
              "result": true,
              "failed_tests": true,
              "summary": true,
              "Value #B": true,
              "Value #C": true,
              "Value #D": true,
              "Value #E": true,
              "Value #F": true,
              "Value #G": true,
              "Value #H": true,
              "Value #I": true,
              "Value #J": true,
              "Value #K": true,
              "inventory_url": true,
              "report": true
            },
            "indexByName": {
              "machine": 0,
              "site": 1,
              "rack": 2,
              "gpu_model": 3,
              "result": 4,
              "failed_tests": 5,
              "summary": 6,
              "Value #B": 7,
              "Value #C": 8,
              "Value #D": 9,
              "Value #E": 10,
              "Value #F": 11,
              "Value #G": 12,
              "Value #H": 13,
              "Value #I": 14,
              "Value #J": 15,
              "Value #K": 16,
              "inventory_url": 17,
              "report": 18
            },
            "renameByName": {
              "machine": "Machine",
              "site": "Site",
              "rack": "Rack",
              "gpu_model": "GPU model",
              "result": "Result",
              "failed_tests": "Failed tests",
              "summary": "Why",
              "Value #B": "Finished",
              "Value #C": "Failures in a row",
              "Value #D": "GPUs",
              "Value #E": "Expected",
              "Value #F": "Uncorrected ECC",
              "Value #G": "Soak peak (C)",
              "Value #H": "GPUs with XID",
              "Value #I": "Inactive NVLinks",
              "Value #J": "Fabric unhealthy",
              "Value #K": "GPUs with NVLink errors",
              "inventory_url": "Inventory",
              "report": "QualificationReport"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Finished",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Machine"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open server",
                    "url": "/d/gpu-burn-in-server?var-machine=${__value.raw}&${datasource:queryparam}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Inventory"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in the inventory",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Finished"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Why"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Result"
            },
            "properties": [
