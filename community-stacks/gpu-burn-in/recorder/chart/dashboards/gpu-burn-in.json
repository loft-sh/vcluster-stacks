    "vcluster",
    "fleet-observability",
    "gpu",
    "qualification",
    "burn-in",
    "fleet"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "links": [
    {
      "title": "GPU Burn-In: Failures",
      "url": "/d/gpu-burn-in-failures",
      "type": "link",
      "tags": [],
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "GPU Burn-In: Server",
