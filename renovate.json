{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["dependencies"],
  "ignorePaths": [
    "**/.terraform/**"
  ],
  "packageRules": [
    {
      "description": "Group all GitHub Actions updates into a single PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group OpenTofu provider updates into a single PR",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["provider"],
      "groupName": "terraform-providers"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned tool versions in CI workflows",
      "fileMatch": ["^\\.github/workflows/.+\\.yml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+[^\\n]*?'(?<currentValue>[^']+)'"
      ]
    },
    {
      "customType": "regex",
      "description": "OpenClaw: container images pinned as parameter defaults in the StackTemplate and Apps",
      "fileMatch": ["^community-stacks/openclaw/stacktemplate\\.yaml$", "^community-stacks/openclaw/apps/.+\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\s+defaultValue: \"?[^\\s\":]+:(?<currentValue>[^\\s\"]+)\"?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "OpenClaw: npm packages pinned as parameter defaults in the StackTemplate and Apps",
      "fileMatch": ["^community-stacks/openclaw/stacktemplate\\.yaml$", "^community-stacks/openclaw/apps/.+\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=npm depName=(?<depName>\\S+)\\s+defaultValue: \"?(?<currentValue>[^\\s\"]+)\"?"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "OpenClaw: vCluster version pinned in the tenant cluster template",
      "fileMatch": ["^community-stacks/openclaw/virtualclustertemplate\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+version: \"?(?<currentValue>[^\\s\"]+)\"?"
      ]
    },
    {
      "customType": "regex",
      "description": "NVIDIA GPU Operator: chart and release versions pinned as parameter defaults",
      "fileMatch": ["^community-stacks/nvidia-gpu-operator/stacktemplate\\.yaml$", "^community-stacks/nvidia-gpu-operator/virtualclustertemplate\\.yaml$", "^community-stacks/nvidia-gpu-operator/apps/.+\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\s+defaultValue: [\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "NVIDIA GPU Operator: vCluster version pinned in the tenant cluster template",
      "fileMatch": ["^community-stacks/nvidia-gpu-operator/virtualclustertemplate\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+version: \"?(?<currentValue>[^\\s\"]+)\"?"
      ]
    }
  ]
}
